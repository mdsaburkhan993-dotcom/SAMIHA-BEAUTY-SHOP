rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAppAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mdsaburkhan993@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validators ---
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.sku is string && data.sku.size() > 0 && data.sku.size() <= 50
        && data.category is string && data.category.size() <= 100
        && data.purchasePrice is number && data.purchasePrice >= 0
        && data.sellingPrice is number && data.sellingPrice >= 0
        && data.stockQuantity is number && data.stockQuantity >= 0;
    }

    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 150
        && data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 30
        && data.totalAmount is number && data.totalAmount >= 0
        && data.orderStatus in ['pending', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled']
        && data.paymentStatus in ['unpaid', 'paid', 'partially_paid'];
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30;
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.category in ['business', 'personal', 'inventory', 'customer']
        && data.priority in ['low', 'medium', 'high']
        && data.isCompleted is bool;
    }

    // --- Products Collection Rules ---
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isAppAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAppAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAppAdmin() && isValidId(productId);
    }

    // --- Orders Collection Rules ---
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming());
      allow update: if isAppAdmin() && isValidId(orderId) && isValidOrder(incoming());
      allow delete: if isAppAdmin() && isValidId(orderId);
    }

    // --- Customers Collection Rules (PII Protected) ---
    match /customers/{customerId} {
      allow read: if isAppAdmin();
      allow create: if isAppAdmin() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isAppAdmin() && isValidId(customerId) && isValidCustomer(incoming());
      allow delete: if isAppAdmin() && isValidId(customerId);
    }

    // --- Suppliers Collection Rules ---
    match /suppliers/{supplierId} {
      allow read: if isAppAdmin();
      allow create, update, delete: if isAppAdmin() && isValidId(supplierId);
    }

    // --- Returns Collection Rules ---
    match /returns/{returnId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(returnId);
      allow update, delete: if isAppAdmin() && isValidId(returnId);
    }

    // --- User Personal Tasks ---
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId && isValidId(taskId) && (request.method != 'create' || isValidTask(incoming()));
    }
  }
}
